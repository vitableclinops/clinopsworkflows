# Granola API token — Granola app > Settings > API
GRANOLA_API_TOKEN=your_granola_api_token_here

# Slack bot token — https://api.slack.com/apps
# Required bot scopes: chat:write, chat:write.public
SLACK_BOT_TOKEN=xoxb-...

# Linear personal API key — https://linear.app/settings/api
LINEAR_API_KEY=lin_api_...

# Override which Linear team to file issues under (default: Clinical)
# LINEAR_CLINOPS_TEAM_NAME=Clinical

# Override the Granola meeting title to match (default: ClinOps Weekly Sync)
# GRANOLA_MEETING_TITLE=ClinOps Weekly Sync
