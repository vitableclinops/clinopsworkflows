# ── ClinOps Weekly Sync workflow ────────────────────────────────────────────

# Granola API token — Granola app > Settings > API
GRANOLA_API_TOKEN=your_granola_api_token_here

# Slack bot token — https://api.slack.com/apps
# Required bot scopes: chat:write, chat:write.public
SLACK_BOT_TOKEN=xoxb-...

# Linear personal API key — https://linear.app/settings/api
LINEAR_API_KEY=lin_api_...

# Override which Linear team to file issues under (default: Clinical)
# LINEAR_CLINOPS_TEAM_NAME=Clinical

# Override the Granola meeting title to match (default: ClinOps Weekly Sync)
# GRANOLA_MEETING_TITLE=ClinOps Weekly Sync


# ── Availability Sync workflow ───────────────────────────────────────────────

# Jotform API key — jotform.com/myaccount/api
JOTFORM_API_KEY=your_jotform_api_key_here

# Notion integration token — notion.so/my-integrations
# The integration must be shared with:
#   - Schedule Builder database
#   - Provider Scheduling Status database
NOTION_TOKEN=secret_...

# Anthropic API key — console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Bootstrap: Jotform submission ID to start processing from (first run only).
# Set this to the ID of the last submission Zapier already pushed to Notion.
# On subsequent runs the state file (.github/availability-state.json) is used.
# SINCE_ID_OVERRIDE=
